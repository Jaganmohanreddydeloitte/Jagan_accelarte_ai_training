# =============================================================================
# AI Provider Configuration
# =============================================================================
# Choose which AI provider to use: "groq", "gemini", "openai", or "github"
LLM_PROVIDER=groq

# =============================================================================
# API Keys (you only need ONE based on your chosen provider)
# =============================================================================

# Groq - Fast AI inference
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini AI
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI / ChatGPT
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Models
# Get your token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# =============================================================================
# Optional Model Configuration
# =============================================================================

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# GitHub model to use (default: openai/gpt-4.1-mini)
GITHUB_MODEL=openai/gpt-4.1-mini

# =============================================================================
# PostgreSQL Configuration (Optional - for Gold layer export)
# =============================================================================
# Set ENABLE_POSTGRES_EXPORT=true to export Gold layer tables to PostgreSQL

ENABLE_POSTGRES_EXPORT=false

# PostgreSQL Connection String
# Format: postgresql://username:password@hostname:port/database_name
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/idamp_analytics
#   AWS RDS: postgresql://user:pass@xxx.rds.amazonaws.com:5432/dbname
#   Google Cloud SQL: postgresql://user:pass@127.0.0.1:5432/db (with Cloud SQL Proxy)
DATABASE_URL=postgresql://postgres:password@localhost:5432/idamp_analytics

# Or use individual components (if you don't use DATABASE_URL):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=idamp_analytics

# PostgreSQL Schema name (default: public)
POSTGRES_SCHEMA=analytics

# Auto-create tables if they don't exist (default: true)
POSTGRES_AUTO_CREATE_TABLES=true

# Drop existing tables before recreating (default: false - use only for testing!)
POSTGRES_DROP_EXISTING_TABLES=false

# =============================================================================
# Email Notifications (Optional)
# =============================================================================

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=gmail

# Gmail Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Outlook Configuration
OUTLOOK_USER=your-email@outlook.com
OUTLOOK_PASSWORD=your-password

# Report Recipients
REPORT_RECIPIENTS=recipient@company.com
